# @generated by `cargo buckal`
#
# Verifies that buckal's (os, cpu)-keyed conditional dependencies survive the
# trip through `wrapper.bzl` and Buck2's select refinement.
#
# `cargo buckal migrate` evaluates every `cfg(...)` predicate against six
# (os, cpu) pairs and emits `os_deps` / `os_named_deps` keyed either by an OS
# name (`linux`) or by a refined pair (`linux-arm64`). The buckal cell's
# `wrapper.bzl` lowers those maps into a `select()`. Two things can go wrong
# there, and neither one fails a build on the host that generated the files:
#
#   1. A refined key names a platform the repo has no `platform()` target for.
#      The branch is then unreachable, so the deps in it are silently dropped
#      and the failure only appears when someone builds that platform.
#   2. A refined branch fails to carry the OS-level deps it refines. Buck2
#      picks exactly one select branch -- it does not union the branches that
#      match -- so a crate with both a `cfg(unix)` dep and a
#      `cfg(all(aarch64, linux))` dep loses the former on linux-arm64 unless
#      the refined branch repeats it. See `_inherited_keys` in `wrapper.bzl`.
#
# Both are pure graph properties, so this check needs no compiler and no
# toolchain for the platform under test: a Linux x86_64 runner can prove the
# windows-arm64 lowering is intact.
#
# Usage:
#   buck2 bxl //platforms/verify_deps.bxl:check
#   buck2 bxl //platforms/verify_deps.bxl:check -- --pattern //third-party/...
#   buck2 bxl //platforms/verify_deps.bxl:check -- --configured false
#   buck2 bxl //platforms/verify_deps.bxl:dump

# The (os, cpu) matrix cargo-buckal lowers against, mapped to the `platform()`
# targets this package generates. Keep in sync with `SUPPORTED_TARGETS` in
# cargo-buckal's `src/platform.rs` and `_PLATFORM_LABELS` in `wrapper.bzl`.
_EXPECTED_PLATFORMS = {
    "linux-arm64": "//platforms:aarch64-unknown-linux-gnu",
    "linux-x86_64": "//platforms:x86_64-unknown-linux-gnu",
    "macos-arm64": "//platforms:aarch64-apple-darwin",
    "macos-x86_64": "//platforms:x86_64-apple-darwin",
    "windows-arm64": "//platforms:aarch64-pc-windows-msvc",
    "windows-x86_64": "//platforms:x86_64-pc-windows-msvc",
}

# Bare-OS select keys, as emitted by `_OS_LABELS` in `wrapper.bzl`.
_OS_KEYS = {
    "prelude//os/constraints:linux": "linux",
    "prelude//os/constraints:macos": "macos",
    "prelude//os/constraints:windows": "windows",
}

# Refined (os, cpu) select keys all live in the buckal cell.
_REFINED_PREFIX = "buckal//platforms:"

_RUST_RULES = [
    "prelude//rules.bzl:rust_binary",
    "prelude//rules.bzl:rust_library",
    "prelude//rules.bzl:rust_test",
]

# `wrapper.bzl` merges `os_deps` into `deps` and `os_named_deps` into
# `named_deps` before handing the rule to the prelude, so these are the two
# attributes a refined key can end up in.
_DEP_ATTRS = ["deps", "named_deps"]

def _labels_of(value):
    """Dep labels in one select branch: a list (deps) or a dict (named_deps)."""
    if value == None:
        return []
    if type(value) == type({}):
        return [str(v) for v in value.values()]
    if type(value) == type([]):
        return [str(v) for v in value]
    return [str(value)]

def _collect_branches(attr, acc):
    """Flatten a possibly-nested select into {key string: [dep label]}.

    `apply_platform_attrs` can leave a concat of selects, so this recurses
    rather than assuming a single `select()` at the top.
    """
    if isinstance(attr, bxl.SelectDict):
        for key, value in attr.select_items():
            name = str(key)
            acc[name] = acc.get(name, []) + _labels_of(value)
    elif isinstance(attr, bxl.SelectConcat):
        for part in attr.select_iter():
            _collect_branches(part, acc)
    return acc

def _branches_of(node):
    acc = {}
    for attr_name in _DEP_ATTRS:
        if node.has_attr(attr_name):
            _collect_branches(node.get_attr(attr_name), acc)
    return acc

def _os_of(refined_key):
    # CPU names contain `_` (`x86_64`) but never `-`, so the first `-` is the
    # OS/CPU boundary -- same rule as `_os_of` in `wrapper.bzl`.
    return refined_key.split("-")[0]

def _normalize(label):
    """Strip the prelude's proc-macro rename so declared and resolved labels match.

    `rust_library(proc_macro = True)` builds the real rule as `_<name>` and
    puts a `rust_proc_macro_alias` at `<name>` (see `rust_library.bzl`), so a
    dep written as `//x:serde_derive` shows up in the configured graph as
    `//x:_serde_derive`. buckal never emits a leading underscore itself, so
    dropping one is unambiguous.
    """
    if ":" not in label:
        return label
    package, _, name = label.rpartition(":")
    if name.startswith("_"):
        name = name[1:]
    return package + ":" + name

def _rust_targets(ctx, pattern):
    nodes = ctx.unconfigured_targets(pattern)
    return [n for n in nodes if n.rule_type in _RUST_RULES]

def _available_platforms(ctx):
    available = {}
    missing = []
    for name in sorted(_EXPECTED_PLATFORMS):
        label = _EXPECTED_PLATFORMS[name]
        if ctx.target_exists(label):
            available[name] = label
        else:
            missing.append(name)
    return available, missing

def _rust_deps_of(node):
    deps = []
    for dep in node.deps():
        if dep.rule_type in _RUST_RULES:
            deps.append(str(dep.label.raw_target()))
    return sorted(deps)

def _check_impl(ctx: bxl.Context):
    failures = []
    notes = []

    available, missing = _available_platforms(ctx)
    if missing:
        notes.append(
            "no platform() target for " + ", ".join(missing) +
            " -- refined deps keyed to those pairs cannot be verified",
        )

    rust_nodes = _rust_targets(ctx, ctx.cli_args.pattern)
    notes.append("inspected " + str(len(rust_nodes)) + " rust targets under " + ctx.cli_args.pattern)

    # Targets whose select mentions at least one refined key, with the branches
    # we read off the unconfigured graph, so the configured pass below can
    # reuse them instead of walking every target a second time.
    refined = {}

    for node in rust_nodes:
        label = str(node.label)
        branches = _branches_of(node)
        refined_keys = sorted([k for k in branches if k.startswith(_REFINED_PREFIX)])
        if not refined_keys:
            continue
        refined[label] = branches

        for key in refined_keys:
            short = key[len(_REFINED_PREFIX):]

            # Failure mode 1: the branch cannot be reached by any platform.
            if short not in _EXPECTED_PLATFORMS:
                failures.append(
                    label + ": select key `" + key + "` is not one of the " +
                    str(len(_EXPECTED_PLATFORMS)) + " supported (os, cpu) pairs",
                )
                continue
            if short not in available:
                failures.append(
                    label + ": select key `" + key + "` is unreachable -- " +
                    _EXPECTED_PLATFORMS[short] + " does not exist, so " +
                    str(sorted(branches[key])) + " is dropped on that platform",
                )
                continue

            # Failure mode 2: the refined branch dropped the OS-level deps.
            os_name = _os_of(short)
            for os_key in _OS_KEYS:
                if _OS_KEYS[os_key] != os_name or os_key not in branches:
                    continue
                lost = [d for d in branches[os_key] if d not in branches[key]]
                if lost:
                    failures.append(
                        label + ": branch `" + key + "` drops OS-level deps " +
                        str(sorted(lost)) + " -- Buck2 picks one branch, so the " +
                        "refined branch must repeat what it refines",
                    )

    notes.append(str(len(refined)) + " of them use (os, cpu)-refined keys")

    # Failure mode 1b: the branches are well-formed, but Buck2's select
    # refinement does not actually land on them. Catches a platform that
    # declares an OS without a CPU, and any future change to how refinement
    # resolves overlapping config_settings.
    if ctx.cli_args.configured:
        checked = 0
        for label in sorted(refined):
            branches = refined[label]
            for key in sorted([k for k in branches if k.startswith(_REFINED_PREFIX)]):
                short = key[len(_REFINED_PREFIX):]
                if short not in available:
                    continue
                node = ctx.configured_targets(label, available[short])
                if node == None:
                    continue
                resolved = _rust_deps_of(node)
                normalized = [_normalize(d) for d in resolved]
                checked += 1
                for want in sorted(branches[key]):
                    if _normalize(want) not in normalized:
                        failures.append(
                            label + " configured for " + short + ": declared dep `" +
                            want + "` did not survive select resolution (resolved to " +
                            str(resolved) + ")",
                        )
        notes.append("configured " + str(checked) + " (target, platform) pairs")
    else:
        notes.append("configured pass skipped (--configured false)")

    for note in notes:
        ctx.output.print("note: " + note)

    if failures:
        fail(
            "platform dep matrix: " + str(len(failures)) + " failure(s)\n  - " +
            "\n  - ".join(sorted(failures)),
        )

    ctx.output.print("OK: platform dep matrix is consistent")

def _dump_impl(ctx: bxl.Context):
    """Print the resolved rust dep set of every rust target, per platform."""
    available, _missing = _available_platforms(ctx)
    out = {}
    for node in _rust_targets(ctx, ctx.cli_args.pattern):
        label = str(node.label)
        per_platform = {}
        for name in sorted(available):
            configured = ctx.configured_targets(label, available[name])
            if configured == None:
                per_platform[name] = None
            else:
                per_platform[name] = _rust_deps_of(configured)
        out[label] = per_platform
    ctx.output.print_json(out)

_PATTERN_ARG = cli_args.string(
    default = "//...",
    doc = "Target pattern to inspect (default: the whole root cell)",
)

check = bxl_main(
    impl = _check_impl,
    cli_args = {
        "configured": cli_args.bool(
            default = True,
            doc = "Also configure each refined target and confirm the branch resolves",
        ),
        "pattern": _PATTERN_ARG,
    },
)

dump = bxl_main(
    impl = _dump_impl,
    cli_args = {
        "pattern": _PATTERN_ARG,
    },
)
